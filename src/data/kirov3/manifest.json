{
  "manifest_version": 3,
  "name": "ELITE FORGE GLOBAL — KIROV3",
  "version": "13.0",
  "description": "Extension Maîtresse : Cycle complet P1-P5 One-Shot — Grade Diamond",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "http://localhost:5005/*",
    "http://127.0.0.1:5005/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*", 
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}