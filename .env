DATABASE_URL=file:/home/z/my-project/db/custom.db

# Google OAuth — get these from Google Cloud Console
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-client-id-here
GOOGLE_CLIENT_SECRET=your-client-secret-here

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=react-forge-secret-key-change-in-production

# SMTP (Gmail) — pour l'envoi d'emails (mot de passe oublié, bienvenue, suppression)
# 1. Va sur https://myaccount.google.com/apppasswords
# 2. Crée un "Mot de passe d'application" (nom: React Forge)
# 3. Copie le mot de passe généré (16 caractères)
SMTP_USER=patriceadja@gmail.com
SMTP_PASS=ton-mot-de-passe-d-application-ici
