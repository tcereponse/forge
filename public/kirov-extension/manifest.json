{
    "manifest_version": 3,
    "name": "ELITE FORGE GLOBAL — KIROV3",
    "version": "13.0",
    "description": "Extension Maîtresse : Cycle complet P1-P5 One-Shot — Grade Diamond",
    "permissions": [
        "activeTab",
        "scripting",
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "*://*.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*",
        "http://localhost:3000/*",
        "http://127.0.0.1:5005/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "index.html"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.deepseek.com/*",
                "*://chat.deepseek.com/*",
                "*://chatgpt.com/*",
                "*://gemini.google.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "*://*.deepseek.com/*",
                "*://chat.deepseek.com/*",
                "*://chatgpt.com/*",
                "*://gemini.google.com/*"
            ],
            "js": [
                "main-world-interceptor.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        }
    ]
}