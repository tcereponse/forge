{
  "manifest_version": 3,
  "name": "ELITE FORGE — KIROV3 Vercel",
  "version": "14.2",
  "description": "Extension pour React Forge sur Vercel — DeepSeek Chat bridge + GitHub Auto-Push",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://chat.deepseek.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "https://forge-kohl-kappa.vercel.app/*",
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
