{
  "manifest_version": 3,
  "name": "ELITE FORGE — KIROV3 Vercel",
  "version": "14.1",
  "description": "Extension avec Auto-Suture et Validation Constitution",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://chat.deepseek.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "https://forge-kohl-kappa.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
