{
  "manifest_version": 3,
  "name": "DIAMOND: Anti-Pollution V13 Souverain",
  "version": "13.0.0",
  "description": "Système de sécurité syntaxique Grade Diamond. Prévient la troncature des imports JS/TS et la pollution des marqueurs IA.",
  "permissions": ["activeTab"],
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*",
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://chat.openai.com/*",
        "*://claude.ai/*",
        "*://gemini.google.com/*"
      ],
      "js": ["inject_antipollution.js"],
      "run_at": "document_idle"
    }
  ]
}
