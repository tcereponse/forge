{
  "manifest_version": 3,
  "name": "PHASE 1 — PRD SOUVERAIN",
  "version": "12.0",
  "description": "Phase 1 : Capture automatique des 10 PRD Markdown — Grade Diamond",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "*://*.deepseek.com/*",
    "*://chatgpt.com/*",
    "*://gemini.google.com/*",
    "http://localhost:5005/*",
    "http://127.0.0.1:5005/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*", 
        "*://chat.deepseek.com/*",
        "*://chatgpt.com/*",
        "*://gemini.google.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
