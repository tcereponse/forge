{
  "manifest_version": 3,
  "name": "PRD: E-Commerce Pack",
  "version": "1.0.0",
  "description": "Pack d'extensions PRD pour la catégorie E-Commerce.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.deepseek.com/*",
        "*://chat.deepseek.com/*"
      ],
      "js": [
        "inject_e_commerce.js"
      ],
      "run_at": "document_idle"
    }
  ]
}