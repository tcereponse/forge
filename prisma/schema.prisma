// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Stack config (stored as plain values for easy querying)
  stack       String   @default("vite") // vite | next | cra
  typescript  Boolean  @default(true)
  styling     String   @default("tailwind") // tailwind | css | styled
  routing     String   @default("router") // router | none
  stateMgmt   String   @default("none") // zustand | context | redux | none
  uiLib       String   @default("none") // shadcn | mui | none
  features    String   @default("[]") // JSON array of strings
  // AI generation outputs (JSON strings)
  prd         String   @default("") // Product Requirements Document (markdown)
  filesJson   String   @default("[]") // JSON array of { path, content, language }
  fileCount   Int      @default(0)
  status      String   @default("draft") // draft | generating | ready | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}
