// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  email        String   @unique
  passwordHash String
  resetToken   String?  
  resetExpiry  DateTime?
  createdAt    DateTime @default(now())
  projects     Project[]
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  username  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  userEmail   String   @default("")
  userId      String?  
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  stack       String   @default("vite")
  typescript  Boolean  @default(true)
  styling     String   @default("tailwind")
  routing     String   @default("router")
  stateMgmt   String   @default("none")
  uiLib       String   @default("none")
  features    String   @default("[]")
  selectedPacks String @default("[]")
  prd         String   @default("")
  arsenalJson String   @default("")
  filesJson   String   @default("[]")
  fileCount   Int      @default(0)
  validationJson String @default("")
  installStatus String  @default("pending")
  buildStatus  String   @default("pending")
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots   Snapshot[]

  @@index([createdAt])
  @@index([userId])
}

model Snapshot {
  id        String   @id @default(cuid())
  projectId String
  label     String   @default("Snapshot")
  filesJson String   @default("[]")
  fileCount Int      @default(0)
  prd       String   @default("")
  note      String   @default("")
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model BridgeState {
  id             String   @id @default(cuid())
  missionId      String   @unique
  name           String   @default("")
  prompt         String   @default("")
  stack          String   @default("react-vite")
  phase          Int      @default(0)
  status         String   @default("idle")
  currentPrompt  String?
  capturedContent String  @default("")
  prd            String   @default("")
  filesJson      String   @default("[]")
  projectId      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// RAG Memory Engine — stores indexed project knowledge chunks
/// in spiral-based categories for context retrieval.
/// Spirales: modeles | standards | exemples | outils | logs
model RagMemory {
  id         String   @id
  project    String
  file       String
  spirale    String   // modeles | standards | exemples | outils | logs
  preview    String   @default("")
  fullContent String  @default("")
  size       Int      @default(0)
  tags       String[] // Store as text array in PostgreSQL
  score      Float    @default(0.5)
  indexedAt  DateTime @default(now())
  
  @@index([project])
  @@index([spirale])
  @@index([score])
  @@index([project, spirale])
}
