// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  // Stack config (stored as plain values for easy querying)
  stack       String   @default("vite") // vite | next | cra
  typescript  Boolean  @default(true)
  styling     String   @default("tailwind") // tailwind | css | styled
  routing     String   @default("router") // router | none
  stateMgmt   String   @default("none") // zustand | context | redux | none
  uiLib       String   @default("none") // shadcn | mui | none
  features    String   @default("[]") // JSON array of strings
  selectedPacks String @default("[]") // JSON array of manually selected extension pack IDs
  // AI generation outputs (JSON strings)
  prd         String   @default("") // Product Requirements Document (markdown)
  arsenalJson String   @default("") // JSON: 10 structured PRD documents (Arsenal Grade Diamond)
  filesJson   String   @default("[]") // JSON array of { path, content, language }
  fileCount   Int      @default(0)
  validationJson String @default("") // JSON validation report from post-processing
  installStatus String  @default("pending") // pending | installing | installed | failed
  buildStatus  String   @default("pending") // pending | building | built | failed
  status      String   @default("draft") // draft | generating | ready | failed
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots   Snapshot[]

  @@index([createdAt])
}

// Versioned snapshots of a project's generated files — lets users save
// restore points before evolving/regenerating, and roll back if needed.
model Snapshot {
  id        String   @id @default(cuid())
  projectId String
  label     String   @default("Snapshot") // user-provided or auto label
  filesJson String   @default("[]") // JSON array of { path, content, language }
  fileCount Int      @default(0)
  prd       String   @default("") // PRD at snapshot time (markdown)
  note      String   @default("") // optional user note
  createdAt DateTime @default(now())

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}
